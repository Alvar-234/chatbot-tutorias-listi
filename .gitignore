.env
__pycache__/
*.pyc
.venv/
.pytest_cache/
# Documentos institucionales y datos generados: no versionar
data/raw/*
!data/raw/.gitkeep
# El manifiesto sí se versiona: indica qué documentos necesita el índice
!data/raw/manifest.yaml
data/processed/*
!data/processed/.gitkeep
data/chroma/*
!data/chroma/.gitkeep
data/structured/*.db
data/structured/*.db.tmp
logs/*
!logs/.gitkeep
eval/results/*
!eval/results/.gitkeep
# Generado por `pip install -e .`
*.egg-info/
# Corpus: los PDF institucionales no se versionan (autorización pendiente); los .md extraídos sí
Documentos/**/*.pdf
documentos_ee_pdf/
# Generado por scripts/extract_ee.py (se regenera desde los PDF + validaciones_ee.yaml)
data/structured/extraido/
